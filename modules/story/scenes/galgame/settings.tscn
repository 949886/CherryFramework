[ext_resource type="Texture2D" path="../../icons/galgame/voice.svg" id="icon_voice"]
[ext_resource type="Texture2D" path="../../icons/galgame/volume.svg" id="icon_volume"]

[sub_resource type="StyleBoxEmpty" id="empty"]

[sub_resource type="ButtonGroup" id="categories"]
resource_local_to_scene = true

[node name="Settings" type="Control"]
theme = ExtResource("editor_theme")
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("script")
presentation = 1
transition = ExtResource("transition")
navigation_path = "ui://cherry/story/settings"
page = "settings"
title = "设置"

[node name="Sheet" type="PanelContainer" parent="."]
theme_type_variation = "StorySheet"
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 26.0
offset_top = 20.0
offset_right = -26.0
offset_bottom = -20.0

[node name="Margin" type="MarginContainer" parent="Sheet"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 28

[node name="Layout" type="VBoxContainer" parent="Sheet/Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Header" type="HBoxContainer" parent="Sheet/Margin/Layout"]
layout_mode = 2

[node name="Heading" type="Label" parent="Sheet/Margin/Layout/Header"]
