[gd_scene format=3]
[ext_resource type="Texture2D" path="../../icons/galgame/back.svg" id="icon_back"]

[ext_resource type="Script" path="../../gdscript/story_menu_page.gd" id="script"]
[ext_resource type="Resource" path="../../resources/galgame_page_transition.tres" id="transition"]
[ext_resource type="PackedScene" path="dialogue_preview.tscn" id="preview"]

[ext_resource type="Theme" path="../../resources/galgame_theme.tres" id="editor_theme"]

[ext_resource type="Texture2D" path="../../icons/galgame/display.svg" id="icon_display"]
[ext_resource type="Texture2D" path="../../icons/galgame/reading.svg" id="icon_reading"]
